# Web administrator reachability. Set ADMIN_BIND_ADDRESS to 127.0.0.1 for
# Local Only or 0.0.0.0 for Network Accessible.
ADMIN_PORT=8740
ADMIN_ACCESS_MODE=local
ADMIN_BIND_ADDRESS=127.0.0.1

# Set a long random value before exposing this service beyond localhost.
ADMIN_SECRET_KEY=change-this-to-a-long-random-value
MANAGEMENT_TOKEN=change-this-to-a-different-long-random-value
SERVER_TIMEZONE=America/Chicago

# Pin the Reticulum release used by the managed rnsd image.
RNS_VERSION=1.5.7
RETICULUM_ADMIN_VERSION=0.1.2
OBSERVER_INTERVAL=30
EVENT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=14
HOST_ARCH=unknown
HOST_OS=unknown
INSTALL_DOCKER_VERSION=unknown
INSTALL_COMPOSE_VERSION=unknown
