# Web administrator reachability. Set ADMIN_BIND_ADDRESS to 127.0.0.1 for
# Local Only or 0.0.0.0 for Network Accessible.
ADMIN_PORT=8740
ADMIN_ACCESS_MODE=local
ADMIN_BIND_ADDRESS=127.0.0.1

# Set a long random value before exposing this service beyond localhost.
ADMIN_SECRET_KEY=change-this-to-a-long-random-value
MANAGEMENT_TOKEN=change-this-to-a-different-long-random-value
SERVER_TIMEZONE=America/Chicago

# Pin the Reticulum release used by the managed rnsd image.
RNS_VERSION=1.5.7
LXMF_VERSION=0.9.6
RETICULUM_ADMIN_VERSION=0.6.1
OBSERVER_INTERVAL=30
RNSD_SNAPSHOT_MAX_AGE=45
EVENT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=14
HOST_ARCH=unknown
HOST_OS=unknown
INSTALL_DOCKER_VERSION=unknown
INSTALL_COMPOSE_VERSION=unknown

# Coordinated configuration-change timeouts: 70-second observer-based restart
# health budget, 170-second agent worker, 180-second web-to-agent call, and a
# 195-second web worker. This accommodates one bounded failed candidate and a
# full health-verified rollback on slower Raspberry Pi systems.
RESTART_HEALTH_TIMEOUT=70
INTERFACE_HEALTH_TIMEOUT=10
MANAGEMENT_HTTP_TIMEOUT=180
MANAGEMENT_PREVIEW_TIMEOUT=5
CONTROL_OPERATION_TIMEOUT=25
